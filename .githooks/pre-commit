#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)

for junk in .scratch .harness-state .qa-artifacts .codex-attachments .worktrees firestore-debug.log; do
    if [ -e "$root/$junk" ]; then
        echo "Commit blocked: remove $junk before committing." >&2
        echo "Run: powershell -ExecutionPolicy Bypass -File tools/pre-commit-cleanup.ps1" >&2
        exit 1
    fi
done

if find "$root/.agents" "$root/.docs" "$root/.githooks" "$root/docs" "$root/app/src" "$root/catalogs" "$root/tools" -maxdepth 5 \( -name '.DS_Store' -o -name 'Thumbs.db' -o -name '*.orig' -o -name '*.rej' \) 2>/dev/null | grep -q .; then
    echo "Commit blocked: remove OS/merge junk (.DS_Store, Thumbs.db, *.orig, *.rej) before committing." >&2
    echo "Run: powershell -ExecutionPolicy Bypass -File tools/pre-commit-cleanup.ps1" >&2
    exit 1
fi

if git diff --cached --name-only --diff-filter=ACMR | LC_ALL=C grep -Eq '^(\.scratch|\.harness-state|\.qa-artifacts|\.codex-attachments|\.worktrees)(/|$)|(^|/)(\.DS_Store|Thumbs\.db|firestore-debug\.log)$|docs/changes/assets/.*/previews-|^docs/changes/.*\.(md|patch)$|^\.docs/(HistoryRecords|OngoingTasks|CompletedTasks)/'; then
    echo "Commit blocked: temporary/junk or separate history file staged. Use docs/MEMORY.md and run tools/pre-commit-cleanup.ps1." >&2
    exit 1
fi
