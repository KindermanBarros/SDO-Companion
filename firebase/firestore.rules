rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdministrator() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'kindbarros@gmail.com';
    }

    function memberPath(campaignId, uid) {
      return /databases/$(database)/documents/campaignMembers/$(campaignId + '::' + uid);
    }

    function campaignPath(campaignId) {
      return /databases/$(database)/documents/campaigns/$(campaignId);
    }

    function invitePath(inviteId) {
      return /databases/$(database)/documents/campaignInvites/$(inviteId);
    }

    function hasCampaign(campaignId) {
      return campaignId != '' && campaignId != 'default' && exists(campaignPath(campaignId));
    }

    function campaignIsActive(campaignId) {
      return hasCampaign(campaignId)
        && get(campaignPath(campaignId)).data.state == 'ACTIVE';
    }

    function isCampaignOwner(campaignId) {
      return signedIn()
        && hasCampaign(campaignId)
        && get(campaignPath(campaignId)).data.ownerId == request.auth.uid;
    }

    function isCampaignResponsible(campaignId) {
      return isAdministrator() || isCampaignOwner(campaignId);
    }

    function isActiveMemberFor(campaignId, uid) {
      return campaignId != ''
        && campaignId != 'default'
        && exists(memberPath(campaignId, uid))
        && get(memberPath(campaignId, uid)).data.state == 'ACTIVE';
    }

    function isActiveMember(campaignId) {
      return signedIn() && isActiveMemberFor(campaignId, request.auth.uid);
    }

    function isCampaignHistorian(campaignId) {
      // "Mestre" is a campaign relationship, never a global/member role.
      return isAdministrator() || isCampaignOwner(campaignId);
    }

    function canReadCampaign(campaignId) {
      return signedIn() && (isAdministrator() || isCampaignOwner(campaignId) || isActiveMember(campaignId));
    }

    function normalizedCampaignId(data) {
      return data.get('campaignId', '') == 'default' ? '' : data.get('campaignId', '');
    }

    function noCampaign(data) {
      return normalizedCampaignId(data) == '';
    }

    function ownsExistingCharacter() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function existingLockType() {
      return resource.data.get(
        'lockType',
        resource.data.get('isLocked', resource.data.get('locked', false)) == true
          ? 'HISTORIAN'
          : 'NONE'
      );
    }

    function requestedIsLocked() {
      return request.resource.data.get(
        'isLocked',
        request.resource.data.get('locked', false)
      );
    }

    function keepsLockState() {
      return request.resource.data.lockType == existingLockType()
        && requestedIsLocked() == (existingLockType() != 'NONE')
        && request.resource.data.lockedBy == resource.data.lockedBy
        && request.resource.data.get('lockedAt', null) == resource.data.get('lockedAt', null);
    }

    function validPlayerLockTransition() {
      return keepsLockState() || (
        existingLockType() == 'NONE'
        && request.resource.data.lockType == 'PLAYER'
        && requestedIsLocked() == true
        && request.resource.data.lockedBy == request.auth.uid
        && request.resource.data.get('lockedAt', null) != null
      ) || (
        existingLockType() == 'PLAYER'
        && request.resource.data.lockType == 'NONE'
        && requestedIsLocked() == false
        && request.resource.data.lockedBy == ''
        && request.resource.data.get('lockedAt', null) == null
      );
    }

    function validCampaignHistorianLockTransition(campaignId) {
      return keepsLockState() || (
        isCampaignHistorian(campaignId)
        && request.resource.data.lockType == 'HISTORIAN'
        && requestedIsLocked() == true
        && request.resource.data.lockedBy == request.auth.uid
        && request.resource.data.get('lockedAt', null) != null
      ) || (
        isCampaignHistorian(campaignId)
        && request.resource.data.lockType == 'NONE'
        && requestedIsLocked() == false
        && request.resource.data.lockedBy == ''
        && request.resource.data.get('lockedAt', null) == null
      );
    }

    function validAdministratorLockTransition() {
      return keepsLockState() || (
        request.resource.data.lockType == 'HISTORIAN'
        && requestedIsLocked() == true
        && request.resource.data.lockedBy == request.auth.uid
        && request.resource.data.get('lockedAt', null) != null
      ) || (
        request.resource.data.lockType == 'NONE'
        && requestedIsLocked() == false
        && request.resource.data.lockedBy == ''
        && request.resource.data.get('lockedAt', null) == null
      );
    }

    function validCharacterCampaignTarget() {
      let nextCampaign = normalizedCampaignId(request.resource.data);
      return nextCampaign == '' || (
        campaignIsActive(nextCampaign)
        && (isCampaignOwner(nextCampaign) || isActiveMember(nextCampaign))
      );
    }

    function validCharacterCreator() {
      let nextCampaign = normalizedCampaignId(request.resource.data);
      return isAdministrator() || request.resource.data.ownerId == request.auth.uid || (
        nextCampaign != ''
        && campaignIsActive(nextCampaign)
        && isCampaignOwner(nextCampaign)
        && isActiveMemberFor(nextCampaign, request.resource.data.ownerId)
      );
    }

    function campaignCharacterWritable() {
      let existingCampaign = normalizedCampaignId(resource.data);
      return existingCampaign != ''
        && campaignIsActive(existingCampaign)
        && isCampaignHistorian(existingCampaign);
    }

    match /campaigns/{campaignId} {
      // Using resource.data.ownerId makes ownerId-filtered list queries provable by rules.
      allow read: if signedIn() && (
        isAdministrator()
        || resource.data.ownerId == request.auth.uid
        || isActiveMember(campaignId)
      );

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.state == 'ACTIVE'
        && request.resource.data.get('archivedAt', null) == null;

      allow update: if signedIn()
        && isCampaignResponsible(campaignId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.state in ['ACTIVE', 'ARCHIVED', 'DELETED']
        && (
          (resource.data.state == 'ACTIVE' && request.resource.data.state in ['ACTIVE', 'ARCHIVED'])
          || (
            resource.data.state == 'ARCHIVED'
            && request.resource.data.state in ['ACTIVE', 'DELETED']
            && request.resource.data.ownerId == resource.data.ownerId
          )
        );

      allow delete: if false;
    }

    match /campaignMembers/{membershipId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || canReadCampaign(resource.data.campaignId)
      );

      allow create: if signedIn() && (
        (
          request.resource.data.userId == request.auth.uid
          && request.resource.data.role == 'PLAYER'
          && request.resource.data.state == 'ACTIVE'
          && request.resource.data.joinedByInviteId == ''
          && campaignIsActive(request.resource.data.campaignId)
          && isCampaignOwner(request.resource.data.campaignId)
        )
        || (
          request.resource.data.userId == request.auth.uid
          && request.resource.data.role == 'PLAYER'
          && request.resource.data.state == 'ACTIVE'
          && request.resource.data.joinedByInviteId != ''
          && exists(invitePath(request.resource.data.joinedByInviteId))
          && get(invitePath(request.resource.data.joinedByInviteId)).data.campaignId == request.resource.data.campaignId
          && get(invitePath(request.resource.data.joinedByInviteId)).data.get('revokedAt', null) == null
          && (
            get(invitePath(request.resource.data.joinedByInviteId)).data.get('expiresAt', null) == null
            || get(invitePath(request.resource.data.joinedByInviteId)).data.expiresAt > request.time.toMillis()
          )
          && campaignIsActive(request.resource.data.campaignId)
        )
      );

      allow update: if signedIn() && request.resource.data.campaignId == resource.data.campaignId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.role == 'PLAYER'
        && (
          (
            isCampaignResponsible(resource.data.campaignId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'role', 'state', 'updatedAt', 'characterIds'
            ])
          )
          || (
            campaignIsActive(resource.data.campaignId)
            && resource.data.userId == request.auth.uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.joinedAt == resource.data.joinedAt
            && request.resource.data.joinedByInviteId == resource.data.joinedByInviteId
            && request.resource.data.state == 'LEFT'
            && request.resource.data.characterIds.size() == 0
          )
        );

      allow delete: if signedIn() && isCampaignResponsible(resource.data.campaignId);
    }

    match /campaignInvites/{inviteId} {
      allow get: if signedIn() && (
        isCampaignResponsible(resource.data.campaignId)
        || (
          resource.data.get('revokedAt', null) == null
          && (
            resource.data.get('expiresAt', null) == null
            || resource.data.expiresAt > request.time.toMillis()
          )
          && campaignIsActive(resource.data.campaignId)
        )
      );

      allow list: if signedIn() && canReadCampaign(resource.data.campaignId);

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.code == inviteId
        && request.resource.data.campaignId != ''
        && campaignIsActive(request.resource.data.campaignId)
        && isCampaignResponsible(request.resource.data.campaignId)
        && request.resource.data.get('revokedAt', null) == null;

      // One reusable code is created with the campaign and remains immutable.
      allow update: if false;

      allow delete: if signedIn() && isCampaignResponsible(resource.data.campaignId);
    }

    match /campaignAudit/{operationId} {
      allow read: if signedIn() && (
        (resource.data.campaignId == '' && resource.data.actorId == request.auth.uid)
        || canReadCampaign(resource.data.campaignId)
      );
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.idempotencyKey == operationId
        && (
          request.resource.data.campaignId == ''
          || canReadCampaign(request.resource.data.campaignId)
        );
      allow update, delete: if false;
    }

    match /campaignLibrary/{entryId} {
      allow read: if signedIn() && canReadCampaign(resource.data.campaignId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isCampaignHistorian(request.resource.data.campaignId);
      allow update: if signedIn()
        && request.resource.data.campaignId == resource.data.campaignId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && isCampaignHistorian(resource.data.campaignId);
      allow delete: if false;
    }

    match /campaignDeliveries/{deliveryId} {
      allow read: if signedIn() && (
        resource.data.recipientId == request.auth.uid
        || isCampaignHistorian(resource.data.campaignId)
      );
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.state == 'PENDING'
        && isCampaignHistorian(request.resource.data.campaignId);
      allow update: if signedIn()
        && request.resource.data.campaignId == resource.data.campaignId
        && request.resource.data.libraryEntryId == resource.data.libraryEntryId
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.recipientCharacterId == resource.data.recipientCharacterId
        && request.resource.data.snapshotKind == resource.data.snapshotKind
        && request.resource.data.snapshotName == resource.data.snapshotName
        && request.resource.data.snapshotSummary == resource.data.snapshotSummary
        && request.resource.data.snapshotPayload == resource.data.snapshotPayload
        && request.resource.data.knowledgeMapping == resource.data.knowledgeMapping
        && request.resource.data.knowledgeBonus == resource.data.knowledgeBonus
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && resource.data.state == 'PENDING'
        && request.resource.data.state in ['ACCEPTED', 'DECLINED']
        && resource.data.recipientId == request.auth.uid;
      allow delete: if false;
    }

    match /characters/{characterId} {
      allow read: if signedIn() && (
        isAdministrator()
        || resource.data.ownerId == request.auth.uid
        || (
          normalizedCampaignId(resource.data) != ''
          && canReadCampaign(normalizedCampaignId(resource.data))
        )
      );

      allow create: if signedIn()
        && validCharacterCreator()
        && validCharacterCampaignTarget()
        && request.resource.data.lockType == 'NONE'
        && requestedIsLocked() == false
        && request.resource.data.lockedBy == ''
        && request.resource.data.get('lockedAt', null) == null
        && request.resource.data.deleted == false;

      allow update: if signedIn()
        && (
          (
            normalizedCampaignId(resource.data) != ''
            && isCampaignResponsible(normalizedCampaignId(resource.data))
            && getAfter(campaignPath(normalizedCampaignId(resource.data))).data.state == 'DELETED'
            && normalizedCampaignId(request.resource.data) == ''
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['campaignId', 'updatedAt'])
          )
          || (
            isAdministrator()
            && request.resource.data.get('deleted', false) == resource.data.get('deleted', false)
            && (
              request.resource.data.ownerId == resource.data.ownerId
              || exists(/databases/$(database)/documents/users/$(request.resource.data.ownerId))
            )
            && validAdministratorLockTransition()
          )
          ||
          (
            ownsExistingCharacter()
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.deleted == resource.data.get('deleted', false)
            && validPlayerLockTransition()
            && validCharacterCampaignTarget()
          )
          || (
            campaignCharacterWritable()
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.get('deleted', false) == resource.data.get('deleted', false)
            && normalizedCampaignId(request.resource.data) == normalizedCampaignId(resource.data)
            && validCampaignHistorianLockTransition(normalizedCampaignId(resource.data))
          )
          || (
            normalizedCampaignId(resource.data) != ''
            && getAfter(campaignPath(normalizedCampaignId(resource.data))).data.state == 'DELETED'
            && isCampaignResponsible(normalizedCampaignId(resource.data))
            && normalizedCampaignId(request.resource.data) == ''
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['campaignId', 'updatedAt'])
          )
        );

      allow delete: if signedIn() && (
        isAdministrator()
        ||
        ownsExistingCharacter()
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdministrator());

      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.get('role', 'USER') == 'USER';

      allow update: if signedIn() && (
        isAdministrator()
        || (
          uid == request.auth.uid
          && request.resource.data.get('role', 'USER') == resource.data.get('role', 'USER')
        )
      );

      allow delete: if isAdministrator();
    }
  }
}
