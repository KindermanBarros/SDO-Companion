{
  "rules": {
    ".read": false,
    ".write": false,
    "sheetAggregates": {
      ".read": false,
      ".write": false
    },
    "userSheets": {
      ".read": false,
      ".write": false
    },
    "presence": {
      ".read": false,
      ".write": false
    },
    "grid": {
      "$campaignId": {
        "$gridId": {
          ".read": "auth != null && (data.child('acl').child(auth.uid).child('read').val() === true || data.child('acl').child(auth.uid).child('manage').val() === true)",
          ".write": "auth != null && !data.exists() && newData.child('acl').child(auth.uid).child('manage').val() === true && newData.child('acl').child(auth.uid).child('read').val() === true",
          ".validate": "newData.hasChild('acl')",
          "acl": {
            ".read": "auth != null && (data.child(auth.uid).child('read').val() === true || data.child(auth.uid).child('manage').val() === true)",
            ".write": "auth != null && data.parent().child('acl').child(auth.uid).child('manage').val() === true",
            "$uid": {
              ".validate": "newData.hasChildren(['read'])",
              "read": { ".validate": "newData.isBoolean()" },
              "write": { ".validate": "newData.isBoolean()" },
              "manage": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            }
          },
          "$section": {
            ".write": "auth != null && $section !== 'acl' && (data.parent().child('acl').child(auth.uid).child('write').val() === true || data.parent().child('acl').child(auth.uid).child('manage').val() === true)"
          }
        }
      }
    }
  }
}
