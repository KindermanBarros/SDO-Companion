{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDO Companion powers catalog v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogVersion": {
      "type": "integer",
      "minimum": 1
    },
    "sourceRepository": {
      "type": "string"
    },
    "editorialStatus": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "group",
          "summary",
          "cost",
          "action",
          "range",
          "duration",
          "source",
          "version",
          "creationCost",
          "price",
          "load",
          "durability",
          "region",
          "relatedAttribute",
          "initialValue",
          "prerequisites",
          "mechanicalEffect",
          "ruleReference",
          "keywords",
          "repeatable",
          "limit",
          "activationCondition",
          "enhancements",
          "deactivationCondition"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "const": "POWER"
          },
          "name": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "cost": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "range": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "creationCost": {
            "type": "string"
          },
          "price": {
            "type": "integer"
          },
          "load": {
            "type": "integer"
          },
          "durability": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "relatedAttribute": {
            "type": "string"
          },
          "initialValue": {
            "type": [
              "integer",
              "null"
            ]
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mechanicalEffect": {
            "type": "string"
          },
          "ruleReference": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repeatable": {
            "type": "boolean"
          },
          "limit": {
            "type": "string"
          },
          "activationCondition": {
            "type": "string"
          },
          "enhancements": {
            "type": "string"
          },
          "deactivationCondition": {
            "type": "string"
          }
        }
      }
    }
  }
}
