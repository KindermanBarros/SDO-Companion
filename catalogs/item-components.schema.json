{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDO item component catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "kind", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["GEM", "MODIFICATION"] },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "compatibleItemTypes", "creationCost", "price", "effect"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "compatibleItemTypes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "creationCost": { "type": "integer", "minimum": 0 },
          "price": { "type": "integer", "minimum": 0 },
          "effect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value", "target", "condition", "description"],
            "properties": {
              "type": { "enum": ["ATTRIBUTE", "KNOWLEDGE", "MAGIC_DAMAGE", "DURABILITY", "GEM_POWER", "RULE"] },
              "value": { "type": "integer" },
              "target": { "type": "string" },
              "condition": { "enum": ["EQUIPPED", "WIELDED"] },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
