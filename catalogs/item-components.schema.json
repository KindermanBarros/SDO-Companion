{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDO item component catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "kind", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["GEM", "MODIFICATION", "TECHNOLOGY"] },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "compatibleItemTypes", "creationCost", "price", "effect"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "tier": { "enum": ["COMMON", "UNCOMMON", "RARE", "ANCESTRAL"] },
          "rarity": { "enum": ["COMMON", "UNCOMMON", "RARE", "ANCESTRAL"] },
          "category": { "type": "string", "minLength": 1 },
          "origin": { "type": "string", "minLength": 1 },
          "characterCreationVisible": { "type": "boolean" },
          "compatibleItemTypes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "compatibleBaseGroups": { "type": "array", "items": { "type": "string" } },
          "compatibleBaseIds": { "type": "array", "items": { "type": "string" } },
          "creationCost": { "type": "integer", "minimum": 0 },
          "price": { "type": "integer", "minimum": 0 },
          "load": { "type": "integer" },
          "durability": { "type": "integer", "minimum": 0 },
          "region": { "type": "string" },
          "pg": { "type": "integer" },
          "pl": { "type": "integer" },
          "agilityLimit": { "type": ["integer", "null"], "minimum": 0 },
          "maxCharges": { "type": "integer", "minimum": 0 },
          "recharge": { "type": "string" },
          "activation": { "enum": ["PASSIVE", "ACTION"] },
          "installationKnowledge": { "type": "string" },
          "installationDifficulty": { "type": "string" },
          "removalDifficulty": { "type": "string" },
          "failureEnhancementDamage": { "type": "integer", "minimum": 0 },
          "failureItemDamage": { "type": "integer", "minimum": 0 },
          "enhancementSlots": { "type": "integer", "minimum": 0, "maximum": 5 },
          "effect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value", "target", "condition", "description"],
            "properties": {
              "type": { "enum": ["ATTRIBUTE", "KNOWLEDGE", "ATTACK", "PHYSICAL_DAMAGE", "MAGIC_DAMAGE", "PG", "PL", "AGILITY_LIMIT", "DURABILITY", "DAMAGE_REDUCTION", "DIE_CATEGORY", "GEM_POWER", "RULE"] },
              "value": { "type": "integer" },
              "target": { "type": "string" },
              "condition": { "enum": ["EQUIPPED", "WIELDED"] },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
