{
  "version": 1,
  "modules": [
    {
      "name": ":app",
      "path": "app",
      "main": [
        "app/src/main/java"
      ],
      "test": [
        "app/src/test/java"
      ],
      "android_test": [
        "app/src/androidTest/java"
      ],
      "layers": {
        "data": [
          "app/src/main/java/com/kinderman/sdo/data"
        ],
        "ui": [
          "app/src/main/java/com/kinderman/sdo/ui",
          "app/src/main/java/com/kinderman/sdo/presentation"
        ]
      }
    },
    {
      "name": ":core:domain",
      "path": "core/domain",
      "main": [
        "core/domain/src/main/kotlin"
      ],
      "test": [
        "core/domain/src/test/kotlin"
      ],
      "android_test": [],
      "layers": {
        "domain": [
          "core/domain/src/main/kotlin/com/kinderman/sdo/domain"
        ]
      }
    }
  ],
  "commands": {
    "build": ["./gradlew", ":app:assembleProdDebug"],
    "unit_tests": ["./gradlew", ":core:domain:test", ":app:testProdDebugUnitTest"],
    "ktlint": ["./gradlew", ":app:ktlintCheck"],
    "detekt": ["./gradlew", ":app:detekt"],
    "lint": ["./gradlew", ":app:lintProdDebug"],
    "coverage_report": ["./gradlew", ":app:koverXmlReportProdDebug"]
  },
  "navigation": {
    "destinations": "app/src/main/java/com/kinderman/sdo/presentation/SdoApp.kt",
    "graph": "app/src/main/java/com/kinderman/sdo/presentation/SdoApp.kt",
    "host": "app/src/main/java/com/kinderman/sdo/presentation/SdoApp.kt",
    "required_arguments": {},
    "optional_arguments": {}
  },
  "instrumentation": {
    "application_id": "com.kinderman.sdo",
    "test_application_id": "com.kinderman.sdo.test",
    "runner": "androidx.test.runner.AndroidJUnitRunner"
  },
  "unknowns": [
    "Hilt migration and feature ViewModel split are authorized in docs/engineering/ARCHITECTURE.md and tracked in docs/current/architecture_upgrade_playbook.md.",
    "Custom AppSurface navigation remains the active baseline; navigation-compose dependency is scheduled for removal.",
    "Ktlint/Detekt baseline cleanup and overall coverage improvement remain incremental follow-ups."
  ]
}
